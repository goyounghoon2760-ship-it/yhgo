<!-- ── PRESIDENT BIO ── -->
<section class="bio-section" id="president">
  <div class="bio-image-wrap reveal">
    <div class="bio-accent-border"></div>
    <div class="bio-number">21</div>
    <div class="bio-img-frame">
      <div class="bio-img-inner">
