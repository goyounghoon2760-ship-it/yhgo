<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CINÉPLEX — 오늘의 영화</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">

<style>
:root {
  --black: #080A0F;
  --dark: #0E1117;
  --surface: #141820;
  --card: #1A2030;
  --border: rgba(255,255,255,0.07);
  --white: #F2EFE9;
  --cream: #E8E2D4;
  --muted: #6B7280;
  --red: #E63946;
  --amber: #F4A261;
  --teal: #2EC4B6;
  --text: #C9C3B8;
}

*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}

body {
  font-family: 'DM Sans','Noto Sans KR',sans-serif;
  background: var(--black);
  color: var(--white);
  overflow-x: hidden;
  cursor: none;
}

/* ── FILM GRAIN OVERLAY ── */
body::after {
  content:'';
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:9990;
  opacity:0.032;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)'/%3E%3C/svg%3E");
  animation: grain 0.5s steps(2) infinite;
}
@keyframes grain {
  0%{transform:translate(0,0);}
  25%{transform:translate(-2px,1px);}
  50%{transform:translate(1px,-2px);}
  75%{transform:translate(2px,2px);}
  100%{transform:translate(-1px,0px);}
}

/* ── CURSOR ── */
.cur {
  width:10px;height:10px;
  background:var(--red);
  border-radius:50%;
  position:fixed;
  pointer-events:none;
  z-index:9999;
  transform:translate(-50%,-50%);
  transition:width 0.2s,height 0.2s,background 0.2s;
  mix-blend-mode:difference;
}
.cur-ring {
  width:36px;height:36px;
  border:1.5px solid rgba(242,239,233,0.5);
  border-radius:50%;
  position:fixed;
  pointer-events:none;
  z-index:9998;
  transform:translate(-50%,-50%);
  transition:all 0.15s ease;
}
body.hovering .cur{width:20px;height:20px;}
body.hovering .cur-ring{width:56px;height:56px;border-color:var(--red);}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:var(--black);}
::-webkit-scrollbar-thumb{background:var(--red);border-radius:2px;}

/* ── HEADER ── */
header {
  position:fixed;top:0;left:0;right:0;
  z-index:1000;
  padding:0 40px;
  height:64px;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(8,10,15,0.8);
  backdrop-filter:blur(24px);
  border-bottom:1px solid var(--border);
}

.logo {
  font-family:'Bebas Neue',sans-serif;
  font-size:28px;
  letter-spacing:0.15em;
  color:var(--white);
  text-decoration:none;
  display:flex;align-items:center;gap:10px;
}
.logo-dot{
  width:8px;height:8px;
  background:var(--red);
  border-radius:50%;
  animation:blink 2s ease infinite;
}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0.3;}}

.nav-links{
  display:flex;align-items:center;gap:28px;
}
.nav-links a {
  font-size:13px;
  font-weight:500;
  color:var(--muted);
  text-decoration:none;
  letter-spacing:0.05em;
  transition:color 0.3s;
}
.nav-links a:hover,.nav-links a.active{color:var(--white);}

.search-bar {
  display:flex;align-items:center;gap:0;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:0;
  overflow:hidden;
}
.search-bar input {
  background:none;border:none;outline:none;
  color:var(--white);
  font-size:13px;
  font-family:'DM Sans',sans-serif;
  padding:8px 16px;
  width:180px;
}
.search-bar input::placeholder{color:var(--muted);}
.search-bar button {
  padding:8px 14px;
  background:var(--red);
  border:none;cursor:pointer;
  color:#fff;
  display:flex;align-items:center;
  transition:background 0.2s;
}
.search-bar button:hover{background:#c62d38;}

/* ── HERO ── */
.hero {
  height:100vh;min-height:600px;
  position:relative;overflow:hidden;
  display:flex;align-items:flex-end;
}

.hero-slides {
  position:absolute;inset:0;
}

.hero-slide {
  position:absolute;inset:0;
  opacity:0;
  transition:opacity 1.2s ease;
}
.hero-slide.active{opacity:1;}

.slide-bg {
  width:100%;height:100%;
  position:relative;
  overflow:hidden;
}

/* Cinematic movie-poster style gradients */
.slide-bg::before {
  content:'';
  position:absolute;inset:0;
  z-index:1;
}
.hero-slide:nth-child(1) .slide-bg{background:linear-gradient(155deg,#0A1628 0%,#1A1A2E 30%,#16213E 60%,#0F3460 100%);}
.hero-slide:nth-child(2) .slide-bg{background:linear-gradient(155deg,#1A0A0A 0%,#2D1515 30%,#3D1A1A 60%,#1A0808 100%);}
.hero-slide:nth-child(3) .slide-bg{background:linear-gradient(155deg,#0A1A0F 0%,#0D2B1A 30%,#163D2A 60%,#0A1A12 100%);}
.hero-slide:nth-child(4) .slide-bg{background:linear-gradient(155deg,#1A1200 0%,#2D2000 30%,#3D2E00 60%,#1A1400 100%);}

.slide-art {
  position:absolute;inset:0;z-index:0;
  display:flex;align-items:center;justify-content:flex-end;
  padding-right:10%;
  opacity:0.25;
}

/* Cinescope letter-box bars */
.hero::before,.hero::after {
  content:'';
  position:absolute;left:0;right:0;
  background:var(--black);
  z-index:20;
  height:8vh;
}
.hero::before{top:64px;}
.hero::after{bottom:0;}

.hero-overlay {
  position:absolute;inset:0;z-index:5;
  background:
    linear-gradient(to right, rgba(8,10,15,0.96) 0%, rgba(8,10,15,0.7) 50%, transparent 80%),
    linear-gradient(to top, rgba(8,10,15,0.95) 0%, transparent 50%);
}

.hero-content {
  position:relative;z-index:10;
  padding:0 60px 120px;
  max-width:700px;
}

.hero-badge {
  display:inline-flex;align-items:center;gap:8px;
  background:var(--red);
  padding:4px 14px;
  font-size:10px;
  font-weight:700;
  letter-spacing:0.2em;
  text-transform:uppercase;
  margin-bottom:20px;
  opacity:0;
  animation:fadeSlideUp 0.7s 0.3s ease forwards;
}
.hero-badge .dot {
  width:5px;height:5px;
  background:#fff;
  border-radius:50%;
  animation:blink 1s ease infinite;
}

.hero-genre-tag {
  display:inline-block;
  font-size:11px;
  letter-spacing:0.15em;
  color:var(--amber);
  text-transform:uppercase;
  margin-bottom:16px;
  font-weight:500;
  opacity:0;
  animation:fadeSlideUp 0.7s 0.45s ease forwards;
}

.hero-title {
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(64px,8vw,110px);
  line-height:0.95;
  letter-spacing:0.02em;
  margin-bottom:24px;
  opacity:0;
  animation:fadeSlideUp 0.8s 0.6s ease forwards;
}

.hero-meta {
  display:flex;align-items:center;gap:20px;
  margin-bottom:20px;
  opacity:0;
  animation:fadeSlideUp 0.7s 0.75s ease forwards;
}
.meta-rating {
  display:flex;align-items:center;gap:6px;
  font-size:14px;font-weight:500;
}
.stars {color:#FFD700;font-size:12px;}
.meta-sep{width:3px;height:3px;background:var(--muted);border-radius:50%;}
.meta-info{font-size:13px;color:var(--muted);}

.hero-desc {
  font-size:14px;line-height:1.9;
  color:var(--text);
  font-weight:300;
  max-width:500px;
  margin-bottom:36px;
  opacity:0;
  animation:fadeSlideUp 0.7s 0.9s ease forwards;
}

.hero-actions {
  display:flex;gap:12px;
  opacity:0;
  animation:fadeSlideUp 0.7s 1.05s ease forwards;
}

.btn-watch {
  display:inline-flex;align-items:center;gap:10px;
  padding:13px 32px;
  background:var(--red);
  color:#fff;
  font-size:13px;font-weight:700;
  letter-spacing:0.08em;
  text-transform:uppercase;
  border:none;cursor:pointer;
  font-family:'DM Sans',sans-serif;
  transition:all 0.3s;
  text-decoration:none;
}
.btn-watch:hover{background:#c62d38;transform:translateY(-2px);box-shadow:0 8px 32px rgba(230,57,70,0.4);}
.btn-watch svg{transition:transform 0.3s;}
.btn-watch:hover svg{transform:translateX(3px);}

.btn-info {
  display:inline-flex;align-items:center;gap:10px;
  padding:13px 28px;
  background:rgba(255,255,255,0.08);
  color:var(--white);
  font-size:13px;font-weight:500;
  letter-spacing:0.05em;
  border:1px solid rgba(255,255,255,0.15);
  cursor:pointer;
  font-family:'DM Sans',sans-serif;
  transition:all 0.3s;
  text-decoration:none;
}
.btn-info:hover{background:rgba(255,255,255,0.14);border-color:rgba(255,255,255,0.3);}

/* slide indicators */
.hero-indicators {
  position:absolute;
  right:48px;bottom:120px;
  z-index:20;
  display:flex;flex-direction:column;gap:8px;
}
.hero-indicators button {
  width:3px;height:28px;
  background:rgba(255,255,255,0.2);
  border:none;cursor:pointer;
  transition:all 0.3s;
  padding:0;
}
.hero-indicators button.active{
  background:var(--red);
  height:48px;
}

@keyframes fadeSlideUp {
  from{opacity:0;transform:translateY(24px);}
  to{opacity:1;transform:translateY(0);}
}

/* ── FILTER SECTION ── */
.filter-section {
  padding:48px 60px 32px;
  background:var(--dark);
  border-bottom:1px solid var(--border);
  position:sticky;top:64px;z-index:100;
}

.filter-row {
  display:flex;align-items:center;gap:12px;
  flex-wrap:wrap;
}

.filter-label {
  font-size:11px;
  letter-spacing:0.2em;
  color:var(--muted);
  text-transform:uppercase;
  margin-right:4px;
}

.filter-btn {
  padding:7px 18px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--muted);
  font-size:12px;
  font-family:'DM Sans',sans-serif;
  cursor:pointer;
  border-radius:0;
  letter-spacing:0.05em;
  transition:all 0.25s;
  white-space:nowrap;
}
.filter-btn:hover,.filter-btn.active {
  background:var(--red);
  border-color:var(--red);
  color:#fff;
}

.filter-divider{
  width:1px;height:24px;
  background:var(--border);
  margin:0 8px;
}

.sort-select {
  padding:7px 14px;
  background:var(--surface);
  border:1px solid var(--border);
  color:var(--text);
  font-size:12px;
  font-family:'DM Sans',sans-serif;
  cursor:pointer;
  outline:none;
  appearance:none;
  -webkit-appearance:none;
  letter-spacing:0.05em;
  padding-right:28px;
}

.sort-wrap {
  position:relative;
  display:inline-block;
}
.sort-wrap::after {
  content:'▾';
  position:absolute;
  right:10px;top:50%;
  transform:translateY(-50%);
  color:var(--muted);
  font-size:10px;
  pointer-events:none;
}

/* ── SECTION ── */
.section {
  padding:72px 60px;
}
.section-alt{background:var(--surface);}

.section-header {
  display:flex;align-items:flex-end;
  justify-content:space-between;
  margin-bottom:40px;
}

.section-eyebrow {
  display:flex;align-items:center;gap:10px;
  margin-bottom:8px;
}
.section-eyebrow span {
  font-size:10px;
  letter-spacing:0.3em;
  color:var(--red);
  text-transform:uppercase;
  font-weight:700;
}
.eyebrow-line{
  width:28px;height:1px;
  background:var(--red);
}

.section-title {
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(36px,4vw,54px);
  letter-spacing:0.04em;
  line-height:1;
}

.view-all {
  display:inline-flex;align-items:center;gap:8px;
  font-size:12px;
  color:var(--muted);
  text-decoration:none;
  letter-spacing:0.1em;
  text-transform:uppercase;
  transition:color 0.3s;
  font-weight:500;
  padding-bottom:4px;
  border-bottom:1px solid transparent;
  cursor:pointer;
  background:none;border:none;
  font-family:'DM Sans',sans-serif;
}
.view-all:hover{color:var(--white);border-bottom-color:var(--red);}

/* ── MOVIE GRID ── */
.movie-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:20px;
}
.movie-grid.large{
  grid-template-columns:repeat(auto-fill,minmax(260px,1fr));
}

.movie-card {
  position:relative;
  cursor:pointer;
  group:;
  transition:transform 0.4s ease;
}
.movie-card:hover{transform:translateY(-6px);}

.movie-poster {
  aspect-ratio:2/3;
  position:relative;
  overflow:hidden;
  background:var(--card);
  margin-bottom:14px;
}

.poster-art {
  width:100%;height:100%;
  position:relative;
  transition:transform 0.6s ease;
}
.movie-card:hover .poster-art{transform:scale(1.04);}

.poster-bg {
  width:100%;height:100%;
  display:flex;align-items:center;justify-content:center;
  position:relative;
  overflow:hidden;
}

/* Unique gradient per genre type */
.poster-bg.action{background:linear-gradient(160deg,#1A0A0A 0%,#2D1515 50%,#1A0808 100%);}
.poster-bg.sci-fi{background:linear-gradient(160deg,#050A1A 0%,#0D1A3D 50%,#071228 100%);}
.poster-bg.drama{background:linear-gradient(160deg,#0A0A15 0%,#15152D 50%,#0A0A1A 100%);}
.poster-bg.thriller{background:linear-gradient(160deg,#050505 0%,#151515 50%,#0A0808 100%);}
.poster-bg.romance{background:linear-gradient(160deg,#1A0A0F 0%,#2D1520 50%,#1A0810 100%);}
.poster-bg.comedy{background:linear-gradient(160deg,#0A1200 0%,#152000 50%,#0A1400 100%);}
.poster-bg.horror{background:linear-gradient(160deg,#060200 0%,#100800 50%,#080400 100%);}
.poster-bg.animation{background:linear-gradient(160deg,#001A1A 0%,#002D2D 50%,#001818 100%);}

.poster-icon {
  opacity:0.18;
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
}

.poster-overlay {
  position:absolute;inset:0;
  background:linear-gradient(to top, rgba(8,10,15,0.95) 0%, transparent 50%);
  opacity:0;
  transition:opacity 0.4s;
  display:flex;align-items:flex-end;
  padding:20px;
  z-index:3;
}
.movie-card:hover .poster-overlay{opacity:1;}

.overlay-actions {
  display:flex;flex-direction:column;gap:8px;width:100%;
}
.overlay-btn {
  padding:9px;
  background:var(--red);
  color:#fff;
  border:none;cursor:pointer;
  font-size:12px;font-weight:700;
  letter-spacing:0.1em;
  text-transform:uppercase;
  font-family:'DM Sans',sans-serif;
  transition:background 0.2s;
  display:flex;align-items:center;justify-content:center;gap:6px;
}
.overlay-btn:hover{background:#c62d38;}
.overlay-btn.outline{
  background:rgba(255,255,255,0.1);
  border:1px solid rgba(255,255,255,0.2);
}
.overlay-btn.outline:hover{background:rgba(255,255,255,0.18);}

.poster-badge {
  position:absolute;
  top:12px;left:12px;
  background:var(--red);
  color:#fff;
  font-size:9px;
  font-weight:700;
  padding:3px 8px;
  letter-spacing:0.15em;
  text-transform:uppercase;
  z-index:4;
}
.poster-badge.new{background:var(--teal);}
.poster-badge.hot{background:var(--amber);color:var(--black);}

.poster-score {
  position:absolute;
  top:12px;right:12px;
  background:rgba(8,10,15,0.85);
  padding:4px 8px;
  font-size:12px;
  font-weight:700;
  color:var(--amber);
  z-index:4;
  backdrop-filter:blur(4px);
}

.movie-info {}
.movie-title {
  font-size:15px;
  font-weight:600;
  margin-bottom:4px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  letter-spacing:-0.01em;
}
.movie-sub {
  display:flex;align-items:center;gap:8px;
  font-size:12px;
  color:var(--muted);
}
.movie-sub .genre-tag {
  color:var(--teal);
  font-size:11px;
  letter-spacing:0.05em;
}
.movie-sub .sep{opacity:0.4;}

/* ── FEATURED HORIZONTAL SCROLL ── */
.scroll-row {
  display:flex;gap:16px;
  overflow-x:auto;
  padding-bottom:12px;
  scrollbar-width:thin;
  scrollbar-color:var(--red) transparent;
  scroll-snap-type:x mandatory;
}
.scroll-row::-webkit-scrollbar{height:3px;}
.scroll-row::-webkit-scrollbar-track{background:transparent;}
.scroll-row::-webkit-scrollbar-thumb{background:var(--red);}

.scroll-row .movie-card {
  flex:0 0 200px;
  scroll-snap-align:start;
}

/* ── EDITORIAL FEATURE ── */
.editorial-grid {
  display:grid;
  grid-template-columns:1.6fr 1fr;
  gap:3px;
  background:var(--border);
}

.editorial-main {
  position:relative;
  aspect-ratio:16/9;
  overflow:hidden;
  cursor:pointer;
}

.editorial-side {
  display:grid;
  grid-template-rows:repeat(2,1fr);
  gap:3px;
}

.editorial-item {
  position:relative;
  overflow:hidden;
  cursor:pointer;
}

.ed-bg {
  width:100%;height:100%;
  min-height:200px;
  position:relative;
  transition:transform 0.6s ease;
}
.editorial-main:hover .ed-bg,
.editorial-item:hover .ed-bg{transform:scale(1.04);}

.ed-overlay {
  position:absolute;inset:0;
  background:linear-gradient(to top, rgba(8,10,15,0.92) 0%, rgba(8,10,15,0.3) 60%, transparent 100%);
  z-index:2;
  padding:24px;
  display:flex;flex-direction:column;justify-content:flex-end;
}

.ed-badge {
  display:inline-block;
  font-size:9px;
  font-weight:700;
  letter-spacing:0.2em;
  text-transform:uppercase;
  color:var(--amber);
  margin-bottom:8px;
}
.ed-title {
  font-family:'DM Serif Display',serif;
  font-size:clamp(18px,2vw,28px);
  line-height:1.2;
  margin-bottom:8px;
}
.editorial-item .ed-title{font-size:16px;}
.ed-meta {
  font-size:12px;
  color:var(--muted);
}

.ed-main-bg{background:linear-gradient(135deg,#0A1A30 0%,#1A3050 100%);}
.ed-side1-bg{background:linear-gradient(135deg,#1A0A10 0%,#2D1520 100%);}
.ed-side2-bg{background:linear-gradient(135deg,#0A1A0A 0%,#1A3020 100%);}

/* ── GENRE PILLS HERO ── */
.genre-showcase {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:3px;
  background:var(--border);
  margin-bottom:0;
}

.genre-tile {
  position:relative;
  padding:40px 28px;
  overflow:hidden;
  cursor:pointer;
  transition:flex 0.4s;
}
.genre-tile::before {
  content:'';
  position:absolute;inset:0;
  background:currentColor;
  opacity:0.06;
  transition:opacity 0.3s;
}
.genre-tile:hover::before{opacity:0.14;}

.genre-tile .gt-name {
  font-family:'Bebas Neue',sans-serif;
  font-size:32px;
  letter-spacing:0.04em;
  position:relative;z-index:1;
  transition:color 0.3s;
}
.genre-tile .gt-count {
  font-size:11px;
  color:var(--muted);
  letter-spacing:0.1em;
  position:relative;z-index:1;
  margin-top:4px;
}
.genre-tile .gt-arrow {
  position:absolute;
  bottom:20px;right:20px;
  opacity:0;
  transition:opacity 0.3s,transform 0.3s;
}
.genre-tile:hover .gt-arrow{opacity:1;transform:translate(2px,-2px);}

.genre-tile.action{color:#E63946;background:linear-gradient(135deg,rgba(230,57,70,0.08) 0%,transparent 100%);}
.genre-tile.sci-fi{color:#2EC4B6;background:linear-gradient(135deg,rgba(46,196,182,0.08) 0%,transparent 100%);}
.genre-tile.drama{color:#F4A261;background:linear-gradient(135deg,rgba(244,162,97,0.08) 0%,transparent 100%);}
.genre-tile.thriller{color:#C9C3B8;background:linear-gradient(135deg,rgba(201,195,184,0.08) 0%,transparent 100%);}

/* ── RATING CHART ── */
.top-chart {
  display:flex;flex-direction:column;gap:0;
}

.chart-item {
  display:grid;
  grid-template-columns:40px 56px 1fr auto;
  gap:16px;
  align-items:center;
  padding:18px 0;
  border-bottom:1px solid var(--border);
  cursor:pointer;
  transition:background 0.2s;
  padding-inline:12px;
  margin-inline:-12px;
}
.chart-item:hover{background:rgba(255,255,255,0.03);}
.chart-item:last-child{border-bottom:none;}

.chart-rank {
  font-family:'Bebas Neue',sans-serif;
  font-size:28px;
  color:var(--border);
  line-height:1;
  letter-spacing:0.02em;
}
.chart-rank.top3{color:var(--amber);}

.chart-thumb {
  width:56px;height:80px;
  overflow:hidden;
  flex-shrink:0;
}
.chart-thumb-inner {
  width:100%;height:100%;
}

.chart-info .ci-title {
  font-size:14px;font-weight:600;
  margin-bottom:4px;
  letter-spacing:-0.01em;
}
.chart-info .ci-sub {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 4px;
}
.chart-ott-wrap {
  display: flex;
  gap: 6px;
  margin-bottom: 8px;
}
.ott-badge {
  font-size: 9px;
  padding: 2px 6px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  color: var(--teal);
  text-transform: uppercase;
  font-weight: 700;
}
.chart-review {
  font-size: 11px;
  color: var(--text);
  font-style: italic;
  opacity: 0.8;
  margin-top: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 300px;
}
.chart-bar-wrap {
  height:3px;
  background:rgba(255,255,255,0.07);
  border-radius:1px;
  overflow:hidden;
  max-width:240px;
}
.chart-bar {
  height:100%;
  background:var(--red);
  border-radius:1px;
  transition:width 1.2s ease;
}

.chart-score {
  font-family:'DM Serif Display',serif;
  font-size:22px;
  color:var(--amber);
  text-align:right;
  white-space:nowrap;
}
.chart-score small{
  display:block;
  font-family:'DM Sans',sans-serif;
  font-size:10px;
  color:var(--muted);
  letter-spacing:0.1em;
}

/* ── REVIEW CARDS ── */
.review-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.review-card {
  background:var(--card);
  border:1px solid var(--border);
  padding:28px;
  transition:border-color 0.3s,transform 0.3s;
  cursor:default;
}
.review-card:hover{border-color:rgba(230,57,70,0.3);transform:translateY(-3px);}

.review-stars{color:#FFD700;font-size:13px;margin-bottom:12px;letter-spacing:2px;}
.review-text {
  font-family:'DM Serif Display',serif;
  font-style:italic;
  font-size:15px;
  line-height:1.7;
  color:var(--cream);
  margin-bottom:20px;
}
.review-movie {
  font-size:11px;
  color:var(--red);
  letter-spacing:0.1em;
  text-transform:uppercase;
  font-weight:700;
  margin-bottom:4px;
}
.review-author {
  font-size:12px;
  color:var(--muted);
}
.review-divider {
  width:28px;height:1px;
  background:var(--border);
  margin:12px 0;
}

/* ── NEWSLETTER ── */
.newsletter-section {
  padding:80px 60px;
  background:var(--dark);
  position:relative;
  overflow:hidden;
  text-align:center;
}
.newsletter-section::before {
  content:'';
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:600px;height:300px;
  background:radial-gradient(ellipse,rgba(230,57,70,0.08) 0%,transparent 70%);
  pointer-events:none;
}

.nl-eyebrow {
  font-size:10px;
  letter-spacing:0.3em;
  color:var(--red);
  text-transform:uppercase;
  font-weight:700;
  margin-bottom:16px;
}
.nl-title {
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(40px,5vw,72px);
  letter-spacing:0.03em;
  margin-bottom:16px;
  position:relative;z-index:1;
}
.nl-sub {
  font-size:14px;
  color:var(--muted);
  margin-bottom:36px;
}
.nl-form {
  display:flex;
  max-width:480px;
  margin:0 auto;
}
.nl-form input {
  flex:1;
  padding:14px 20px;
  background:var(--surface);
  border:1px solid var(--border);
  border-right:none;
  color:var(--white);
  font-size:13px;
  font-family:'DM Sans',sans-serif;
  outline:none;
  transition:border-color 0.3s;
}
.nl-form input:focus{border-color:rgba(230,57,70,0.4);}
.nl-form input::placeholder{color:var(--muted);}
.nl-form button {
  padding:14px 28px;
  background:var(--red);
  color:#fff;
  border:none;
  cursor:pointer;
  font-size:12px;
  font-weight:700;
  letter-spacing:0.12em;
  text-transform:uppercase;
  font-family:'DM Sans',sans-serif;
  white-space:nowrap;
  transition:background 0.2s;
}
.nl-form button:hover{background:#c62d38;}

/* ── FOOTER ── */
footer {
  background:#040507;
  padding:64px 60px 32px;
  border-top:1px solid var(--border);
}
.footer-top {
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:60px;
  margin-bottom:56px;
}
.footer-brand-name {
  font-family:'Bebas Neue',sans-serif;
  font-size:32px;
  letter-spacing:0.1em;
  margin-bottom:12px;
  display:flex;align-items:center;gap:10px;
}
.footer-desc {
  font-size:13px;
  color:var(--muted);
  line-height:1.9;
  max-width:260px;
  font-weight:300;
  margin-bottom:24px;
}
.social-row {
  display:flex;gap:10px;
}
.soc-btn {
  width:34px;height:34px;
  border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;
  color:var(--muted);
  transition:all 0.3s;
  text-decoration:none;
}
.soc-btn:hover{border-color:var(--red);color:var(--red);}

.footer-col h4 {
  font-size:11px;
  font-weight:700;
  letter-spacing:0.2em;
  text-transform:uppercase;
  color:var(--red);
  margin-bottom:20px;
}
.footer-col ul{list-style:none;}
.footer-col li{margin-bottom:10px;}
.footer-col a {
  font-size:13px;
  color:var(--muted);
  text-decoration:none;
  font-weight:300;
  transition:color 0.3s;
}
.footer-col a:hover{color:var(--white);}

.footer-bottom {
  padding-top:28px;
  border-top:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center;
}
.footer-bottom p{font-size:12px;color:var(--muted);}
.footer-tags{display:flex;gap:8px;}
.footer-tag {
  font-size:10px;
  padding:3px 10px;
  border:1px solid var(--border);
  color:var(--muted);
  letter-spacing:0.1em;
}

/* ── MODAL ── */
.modal-overlay {
  position:fixed;inset:0;
  background:rgba(4,5,7,0.9);
  z-index:2000;
  display:flex;align-items:center;justify-content:center;
  padding:24px;
  opacity:0;
  pointer-events:none;
  transition:opacity 0.3s;
  backdrop-filter:blur(8px);
}
.modal-overlay.open{opacity:1;pointer-events:all;}

.modal {
  background:var(--surface);
  border:1px solid var(--border);
  max-width:860px;
  width:100%;
  position:relative;
  transform:scale(0.96);
  transition:transform 0.3s;
  overflow:hidden;
}
.modal-overlay.open .modal{transform:scale(1);}

.modal-close {
  position:absolute;top:16px;right:16px;
  background:rgba(255,255,255,0.07);
  border:none;cursor:pointer;
  color:var(--white);
  width:36px;height:36px;
  display:flex;align-items:center;justify-content:center;
  font-size:20px;
  z-index:2;
  transition:background 0.2s;
}
.modal-close:hover{background:var(--red);}

.modal-inner {
  display:grid;
  grid-template-columns:280px 1fr;
}

.modal-poster {
  aspect-ratio:2/3;
  height:100%;
  min-height:420px;
}

.modal-poster-bg {
  width:100%;height:100%;
  display:flex;align-items:center;justify-content:center;
  position:relative;
}

.modal-body {
  padding:40px 36px;
  overflow-y:auto;
  max-height:560px;
}
.modal-genre {
  font-size:11px;
  color:var(--teal);
  letter-spacing:0.15em;
  text-transform:uppercase;
  font-weight:700;
  margin-bottom:12px;
}
.modal-title {
  font-family:'Bebas Neue',sans-serif;
  font-size:48px;
  letter-spacing:0.03em;
  line-height:1;
  margin-bottom:8px;
}
.modal-meta {
  display:flex;flex-wrap:wrap;gap:10px;
  align-items:center;
  margin-bottom:20px;
}
.modal-meta span {
  font-size:12px;
  color:var(--muted);
  display:flex;align-items:center;gap:4px;
}
.modal-meta .score {
  color:var(--amber);
  font-weight:700;
  font-size:14px;
}
.modal-desc {
  font-size:14px;
  line-height:1.9;
  color:var(--text);
  font-weight:300;
  margin-bottom:28px;
}
.modal-cast {
  margin-bottom:28px;
}
.modal-cast h4 {
  font-size:10px;
  letter-spacing:0.2em;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:10px;
}
.cast-list {
  display:flex;gap:8px;flex-wrap:wrap;
}
.cast-pill {
  padding:4px 12px;
  background:rgba(255,255,255,0.05);
  border:1px solid var(--border);
  font-size:11px;
  color:var(--text);
}

.modal-actions{display:flex;gap:10px;}

/* ── SCROLL REVEAL ── */
.reveal{opacity:0;transform:translateY(28px);transition:opacity 0.7s ease,transform 0.7s ease;}
.reveal.visible{opacity:1;transform:none;}

/* Stagger */
.movie-card:nth-child(2){transition-delay:60ms;}
.movie-card:nth-child(3){transition-delay:120ms;}
.movie-card:nth-child(4){transition-delay:180ms;}
.movie-card:nth-child(5){transition-delay:240ms;}
.movie-card:nth-child(6){transition-delay:300ms;}

/* MOBILE */
@media(max-width:900px){
  header{padding:0 20px;}
  .nav-links{display:none;}
  .hero-content{padding:0 24px 140px;}
  .filter-section{padding:20px;}
  .section{padding:48px 20px;}
  .genre-showcase{grid-template-columns:repeat(2,1fr);}
  .review-grid{grid-template-columns:1fr;}
  .editorial-grid{grid-template-columns:1fr;}
  .editorial-side{grid-template-rows:auto auto;}
  .footer-top{grid-template-columns:1fr;gap:32px;}
  .modal-inner{grid-template-columns:1fr;}
  .modal-poster{min-height:240px;aspect-ratio:16/9;}
  .movie-grid{grid-template-columns:repeat(2,1fr);}
  .footer-bottom{flex-direction:column;gap:12px;text-align:center;}
  .nl-form{flex-direction:column;}
  .nl-form input{border-right:1px solid var(--border);border-bottom:none;}
  .chart-item{grid-template-columns:32px 48px 1fr auto;}
}
</style>
</head>
<body>

<div class="cur" id="cur"></div>
<div class="cur-ring" id="curRing"></div>

<!-- ═══════════════ HEADER ═══════════════ -->
<header>
  <a class="logo" href="#">
    <div class="logo-dot"></div>
    CINÉPLEX
  </a>
  <nav class="nav-links">
    <a href="#" class="active">홈</a>
    <a href="#genre">장르</a>
    <a href="#chart">랭킹</a>
    <a href="#reviews">리뷰</a>
  </nav>
  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="영화 제목, 감독, 배우 검색…" oninput="filterMovies()">
    <button>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <circle cx="5.5" cy="5.5" r="4.5" stroke="#fff" stroke-width="1.5"/>
        <line x1="9" y1="9" x2="13" y2="13" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</header>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="hero" id="hero">
  <div class="hero-slides">
    <!-- Slide 1 -->
    <div class="hero-slide active">
      <div class="slide-bg">
        <div class="slide-art">
          <svg width="340" height="480" viewBox="0 0 340 480" fill="none" opacity="0.6">
            <circle cx="170" cy="200" r="140" stroke="rgba(46,196,182,0.3)" stroke-width="1"/>
            <circle cx="170" cy="200" r="100" stroke="rgba(46,196,182,0.2)" stroke-width="1"/>
            <circle cx="170" cy="200" r="60" fill="rgba(46,196,182,0.06)"/>
            <path d="M80 160 L170 60 L260 160 L260 340 L80 340 Z" stroke="rgba(46,196,182,0.15)" stroke-width="1" fill="none"/>
            <rect x="140" y="170" width="60" height="80" rx="2" stroke="rgba(46,196,182,0.4)" stroke-width="1.5" fill="none"/>
            <polygon points="155,195 155,235 185,215" fill="rgba(46,196,182,0.5)"/>
          </svg>
        </div>
      </div>
    </div>
    <!-- Slide 2 -->
    <div class="hero-slide">
      <div class="slide-bg">
        <div class="slide-art">
          <svg width="380" height="480" viewBox="0 0 380 480" fill="none" opacity="0.5">
            <rect x="40" y="80" width="280" height="360" rx="4" stroke="rgba(230,57,70,0.3)" stroke-width="1" fill="none"/>
            <rect x="80" y="120" width="200" height="280" rx="2" stroke="rgba(230,57,70,0.2)" stroke-width="1" fill="rgba(230,57,70,0.04)"/>
            <path d="M140 260 L190 180 L240 260 Z" stroke="rgba(230,57,70,0.5)" stroke-width="2" fill="rgba(230,57,70,0.1)"/>
            <circle cx="190" cy="210" r="30" stroke="rgba(230,57,70,0.4)" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
      </div>
    </div>
    <!-- Slide 3 -->
    <div class="hero-slide">
      <div class="slide-bg">
        <div class="slide-art">
          <svg width="360" height="460" viewBox="0 0 360 460" fill="none" opacity="0.5">
            <path d="M20 380 Q180 40 340 380" stroke="rgba(244,162,97,0.3)" stroke-width="1" fill="none"/>
            <path d="M60 380 Q180 100 300 380" stroke="rgba(244,162,97,0.2)" stroke-width="1" fill="none"/>
            <circle cx="180" cy="200" r="80" stroke="rgba(244,162,97,0.3)" stroke-width="1.5" fill="none"/>
            <circle cx="180" cy="200" r="5" fill="rgba(244,162,97,0.6)"/>
            <line x1="180" y1="120" x2="180" y2="60" stroke="rgba(244,162,97,0.4)" stroke-width="1"/>
            <line x1="260" y1="200" x2="320" y2="200" stroke="rgba(244,162,97,0.4)" stroke-width="1"/>
          </svg>
        </div>
      </div>
    </div>
    <!-- Slide 4 -->
    <div class="hero-slide">
      <div class="slide-bg">
        <div class="slide-art">
          <svg width="360" height="460" viewBox="0 0 360 460" fill="none" opacity="0.5">
            <rect x="60" y="80" width="240" height="320" rx="120" stroke="rgba(201,195,184,0.25)" stroke-width="1" fill="none"/>
            <ellipse cx="180" cy="240" rx="80" ry="120" stroke="rgba(201,195,184,0.2)" stroke-width="1" fill="rgba(201,195,184,0.03)"/>
            <circle cx="180" cy="160" r="40" stroke="rgba(201,195,184,0.35)" stroke-width="1.5" fill="rgba(201,195,184,0.05)"/>
            <line x1="60" y1="240" x2="300" y2="240" stroke="rgba(201,195,184,0.15)" stroke-width="1"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-overlay"></div>

  <!-- Hero content changes with slides -->
  <div class="hero-content" id="heroContent">
    <div class="hero-badge"><div class="dot"></div> 오늘의 추천</div>
    <div class="hero-genre-tag" id="heroGenre">SF · 스릴러</div>
    <h1 class="hero-title" id="heroTitle">인터스텔라</h1>
    <div class="hero-meta">
      <div class="meta-rating">
        <span class="stars">★★★★★</span>
        <span>9.0</span>
      </div>
      <div class="meta-sep"></div>
      <div class="meta-info" id="heroMeta">2014 · 169분 · 크리스토퍼 놀란</div>
    </div>
    <p class="hero-desc" id="heroDesc">지구 종말을 앞두고 인류의 새로운 터전을 찾아 우주로 떠나는 탐험대의 이야기. 블랙홀과 웜홀을 통해 시간과 공간을 초월한 장엄한 여정이 펼쳐진다.</p>
    <div class="hero-actions">
      <button class="btn-watch" onclick="openModal(0)">
        <svg width="12" height="14" viewBox="0 0 12 14" fill="none"><polygon points="0,0 12,7 0,14" fill="#fff"/></svg>
        상세 정보 보기
      </button>
      <a class="btn-info" href="#">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.4"/><line x1="7" y1="6" x2="7" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="7" cy="4" r="0.8" fill="currentColor"/></svg>
        찜하기
      </a>
    </div>
  </div>

  <div class="hero-indicators" id="heroIndicators">
    <button class="active" onclick="goSlide(0)"></button>
    <button onclick="goSlide(1)"></button>
    <button onclick="goSlide(2)"></button>
    <button onclick="goSlide(3)"></button>
  </div>
</section>

<!-- ═══════════════ FILTER ═══════════════ -->
<div class="filter-section">
  <div class="filter-row">
    <span class="filter-label">장르</span>
    <button class="filter-btn active" onclick="setFilter(this,'all')">전체</button>
    <button class="filter-btn" onclick="setFilter(this,'action')">액션</button>
    <button class="filter-btn" onclick="setFilter(this,'sci-fi')">SF</button>
    <button class="filter-btn" onclick="setFilter(this,'drama')">드라마</button>
    <button class="filter-btn" onclick="setFilter(this,'thriller')">스릴러</button>
    <button class="filter-btn" onclick="setFilter(this,'romance')">로맨스</button>
    <button class="filter-btn" onclick="setFilter(this,'comedy')">코미디</button>
    <button class="filter-btn" onclick="setFilter(this,'horror')">공포</button>
    <button class="filter-btn" onclick="setFilter(this,'animation')">애니메이션</button>
    <div class="filter-divider"></div>
    <span class="filter-label">정렬</span>
    <div class="sort-wrap">
      <select class="sort-select" onchange="sortMovies(this.value)">
        <option value="rating">평점순</option>
        <option value="year">최신순</option>
        <option value="title">제목순</option>
      </select>
    </div>
  </div>
</div>

<!-- ═══════════════ GENRE SHOWCASE ═══════════════ -->
<div class="genre-showcase">
  <div class="genre-tile action" onclick="setFilterDirect('action')">
    <div class="gt-name">액션</div>
    <div class="gt-count">48편</div>
    <div class="gt-arrow">→</div>
  </div>
  <div class="genre-tile sci-fi" onclick="setFilterDirect('sci-fi')">
    <div class="gt-name">SF</div>
    <div class="gt-count">36편</div>
    <div class="gt-arrow">→</div>
  </div>
  <div class="genre-tile drama" onclick="setFilterDirect('drama')">
    <div class="gt-name">드라마</div>
    <div class="gt-count">62편</div>
    <div class="gt-arrow">→</div>
  </div>
  <div class="genre-tile thriller" onclick="setFilterDirect('thriller')">
    <div class="gt-name">스릴러</div>
    <div class="gt-count">29편</div>
    <div class="gt-arrow">→</div>
  </div>
</div>



<!-- ═══════════════ EDITORIAL ═══════════════ -->
<section class="section section-alt">
  <div class="section-header reveal">
    <div>
      <div class="section-eyebrow"><div class="eyebrow-line"></div><span>Editor's Pick</span></div>
      <h2 class="section-title">에디터 추천</h2>
    </div>
  </div>
  <div class="editorial-grid reveal">
    <div class="editorial-main" onclick="openModal(0)">
      <div class="ed-bg ed-main-bg" style="background: url('https://images.unsplash.com/photo-1612036782180-6f0b6cd846fe?w=1000&q=80') center/cover no-repeat;">
      </div>
      <div class="ed-overlay">
        <div class="ed-badge">★ 2026 기대작</div>
        <h3 class="ed-title">어벤져스:<br>둠스데이</h3>
        <div class="ed-meta">액션 · 2026 · 개봉예정</div>
      </div>
    </div>
    <div class="editorial-side">
      <div class="editorial-item" onclick="openModal(1)">
        <div class="ed-bg ed-side1-bg" style="min-height:200px; background: url('https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=800&q=80') center/cover no-repeat;">
        </div>
