<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>대한민국 대통령 이재명 | 청와대</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;600;700&family=Noto+Sans+KR:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0A1628;
    --deep-blue: #0D2147;
    --royal: #1A3A6B;
    --accent: #C8A96E;
    --gold: #E4C07A;
    --light-gold: #F5E5C0;
    --white: #FAFAF8;
    --muted: #8A9BB5;
    --surface: #0F1E3D;
    --card: #132040;
    --text-light: #D4DCE8;
    --taegeuk-red: #CD2E3A;
    --taegeuk-blue: #003478;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Noto Sans KR', sans-serif;
    background: var(--navy);
    color: var(--white);
    overflow-x: hidden;
  }

  /* ── CURSOR ── */
  .cursor {
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s;
  }
  .cursor-ring {
    width: 32px; height: 32px;
    border: 1px solid rgba(200,169,110,0.5);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: all 0.2s ease;
  }

  /* ── NOISE OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
  }

  /* ── HEADER ── */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 0 48px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(10, 22, 40, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(200,169,110,0.12);
    transition: all 0.3s;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .logo-emblem {
    width: 42px; height: 42px;
    position: relative;
  }

  .logo-emblem svg { width: 100%; height: 100%; }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .logo-text .ko {
    font-family: 'Noto Serif KR', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.05em;
  }

  .logo-text .en {
    font-size: 10px;
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  nav a {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-light);
    text-decoration: none;
    letter-spacing: 0.08em;
    position: relative;
    transition: color 0.3s;
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0; right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  nav a:hover { color: var(--accent); }
  nav a:hover::after { transform: scaleX(1); transform-origin: left; }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-outline {
    padding: 8px 20px;
    border: 1px solid rgba(200,169,110,0.4);
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.1em;
    cursor: pointer;
    background: transparent;
    transition: all 0.3s;
    font-family: 'Noto Sans KR', sans-serif;
  }

  .btn-outline:hover {
    background: rgba(200,169,110,0.1);
    border-color: var(--accent);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 65% 40%, rgba(26,58,107,0.6) 0%, transparent 65%),
      radial-gradient(ellipse 50% 80% at 20% 60%, rgba(13,33,71,0.8) 0%, transparent 60%),
      linear-gradient(160deg, #06101F 0%, #0A1628 40%, #0D1F3C 100%);
  }

  /* Taegeuk geometric decoration */
  .hero-geo {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 52%;
    overflow: hidden;
  }

  .geo-circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(200,169,110,0.08);
    animation: slowSpin 60s linear infinite;
  }

  .geo-circle:nth-child(1) { width: 700px; height: 700px; top: -100px; right: -100px; }
  .geo-circle:nth-child(2) { width: 500px; height: 500px; top: 50px; right: 50px; border-color: rgba(200,169,110,0.05); animation-direction: reverse; animation-duration: 45s; }
  .geo-circle:nth-child(3) { width: 300px; height: 300px; top: 150px; right: 150px; border-color: rgba(200,169,110,0.1); }

  @keyframes slowSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .hero-portrait {
    position: absolute;
    right: 6%;
    bottom: 0;
    height: 88%;
    opacity: 0;
    animation: fadeUp 1.2s 0.5s ease forwards;
  }

  /* Placeholder portrait (gradient silhouette) */
  .portrait-placeholder {
    position: absolute;
    right: 8%;
    bottom: 0;
    width: 360px;
    height: 80%;
    background: linear-gradient(180deg,
      rgba(26,58,107,0) 0%,
      rgba(26,58,107,0.2) 30%,
      rgba(200,169,110,0.08) 100%
    );
    border-left: 1px solid rgba(200,169,110,0.1);
    opacity: 0;
    animation: fadeUp 1.2s 0.3s ease forwards;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  /* SVG silhouette */
  .portrait-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(10,22,40,0.9) 100%);
    z-index: 1;
  }

  .portrait-svg {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 100%;
    opacity: 0.15;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-content {
    position: relative;
    z-index: 10;
    padding: 0 7%;
    max-width: 640px;
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s ease forwards;
  }

  .hero-label::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--accent);
  }

  .hero-label span {
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 500;
  }

  .hero-title {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.9s 0.35s ease forwards;
  }

  .hero-title .accent-line {
    color: var(--accent);
    font-style: italic;
    font-family: 'Playfair Display', serif;
  }

  .hero-subtitle {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-light);
    margin-bottom: 48px;
    font-weight: 300;
    max-width: 460px;
    opacity: 0;
    animation: fadeUp 0.9s 0.5s ease forwards;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    opacity: 0;
    animation: fadeUp 0.9s 0.65s ease forwards;
  }

  .btn-primary {
    padding: 14px 36px;
    background: var(--accent);
    color: var(--navy);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    cursor: pointer;
    border: none;
    font-family: 'Noto Sans KR', sans-serif;
    transition: all 0.3s;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary:hover {
    background: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(200,169,110,0.3);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-light);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.3s;
    cursor: pointer;
    background: none;
    border: none;
    font-family: 'Noto Sans KR', sans-serif;
  }

  .btn-ghost svg { transition: transform 0.3s; }
  .btn-ghost:hover { color: var(--accent); }
  .btn-ghost:hover svg { transform: translateX(4px); }

  .hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeUp 1s 1s ease forwards;
  }

  .hero-scroll span {
    font-size: 10px;
    letter-spacing: 0.25em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scrollPulse 2s ease infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }

  /* ── MARQUEE ── */
  .marquee-strip {
    background: var(--accent);
    padding: 12px 0;
    overflow: hidden;
    position: relative;
  }

  .marquee-inner {
    display: flex;
    gap: 0;
    animation: marquee 30s linear infinite;
    white-space: nowrap;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 0 32px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--navy);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .marquee-dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--navy);
    opacity: 0.4;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ── SECTION COMMON ── */
  section { position: relative; z-index: 1; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .section-label::before {
    content: '';
    display: block;
    width: 24px;
    height: 1px;
    background: var(--accent);
  }

  .section-label span {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 500;
  }

  .section-title {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* ── PRESIDENT BIO SECTION ── */
  .bio-section {
    padding: 120px 7%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    background: var(--deep-blue);
  }

  .bio-image-wrap {
    position: relative;
  }

  .bio-img-frame {
    width: 100%;
    aspect-ratio: 3/4;
    background: linear-gradient(135deg, var(--royal) 0%, var(--navy) 100%);
    position: relative;
    overflow: hidden;
  }

  .bio-img-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(200,169,110,0.15) 0%, transparent 50%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c8a96e' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .bio-img-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bio-president-icon {
    opacity: 0.3;
  }

  .bio-img-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px 24px;
    background: linear-gradient(to top, rgba(10,22,40,0.95), transparent);
  }

  .bio-img-caption h3 {
    font-family: 'Noto Serif KR', serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .bio-img-caption p {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.15em;
  }

  .bio-accent-border {
    position: absolute;
    top: -16px; left: -16px;
    right: 16px; bottom: 16px;
    border: 1px solid rgba(200,169,110,0.2);
    pointer-events: none;
  }

  .bio-number {
    position: absolute;
    top: 24px; right: -24px;
    font-family: 'Playfair Display', serif;
    font-size: 96px;
    font-weight: 700;
    color: rgba(200,169,110,0.06);
    line-height: 1;
    pointer-events: none;
  }

  .bio-content {}

  .bio-quote {
    font-family: 'Noto Serif KR', serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--light-gold);
    margin-bottom: 32px;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-style: italic;
  }

  .bio-text {
    font-size: 14px;
    line-height: 2;
    color: var(--text-light);
    font-weight: 300;
    margin-bottom: 48px;
  }

  .bio-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .stat-card {
    padding: 20px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(200,169,110,0.12);
    text-align: center;
    transition: all 0.3s;
  }

  .stat-card:hover {
    background: rgba(200,169,110,0.06);
    border-color: rgba(200,169,110,0.3);
    transform: translateY(-4px);
  }

  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--accent);
    display: block;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  /* ── AGENDA SECTION ── */
  .agenda-section {
    padding: 120px 7%;
    background: var(--navy);
  }

  .agenda-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 64px;
  }

  .agenda-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: rgba(200,169,110,0.08);
  }

  .agenda-card {
    background: var(--card);
    padding: 40px 32px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
    cursor: default;
  }

  .agenda-card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .agenda-card:hover {
    background: rgba(26,58,107,0.6);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.3);
  }

  .agenda-card:hover::before { transform: scaleX(1); }

  .agenda-icon {
    width: 48px; height: 48px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(200,169,110,0.1);
    border-radius: 0;
  }

  .agenda-num {
    position: absolute;
    top: 20px; right: 24px;
    font-family: 'Playfair Display', serif;
    font-size: 56px;
    font-weight: 700;
    color: rgba(200,169,110,0.05);
    line-height: 1;
  }

  .agenda-card h3 {
    font-family: 'Noto Serif KR', serif;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .agenda-card p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    font-weight: 300;
  }

  /* ── NEWS SECTION ── */
  .news-section {
    padding: 120px 7%;
    background: var(--surface);
    position: relative;
  }

  .news-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent), transparent);
  }

  .news-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 56px;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 10px;
    background: rgba(255,255,255,0.03);
  }

  .news-card {
    background: var(--card);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.4s;
    position: relative;
  }

  .news-card:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(0,0,0,0.4); }

  .news-img {
    width: 100%;
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, var(--royal) 0%, var(--deep-blue) 100%);
    position: relative;
    overflow: hidden;
  }

  .news-card:first-child .news-img { aspect-ratio: 16/10; }

  .news-img-inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.2;
  }

  .news-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(13,33,71,0.9) 100%);
  }

  .news-cat {
    position: absolute;
    top: 16px; left: 16px;
    background: var(--accent);
    color: var(--navy);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 10px;
    letter-spacing: 0.12em;
    z-index: 2;
  }

  .news-body {
    padding: 24px;
  }

  .news-date {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 10px;
    letter-spacing: 0.1em;
  }

  .news-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.6;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .news-card:first-child .news-title { font-size: 22px; }

  .news-excerpt {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    font-weight: 300;
  }

  /* ── PHOTO SECTION ── */
  .photo-section {
    padding: 120px 7%;
    background: var(--navy);
  }

  .photo-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .photo-masonry {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 240px);
    gap: 4px;
  }

  .photo-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .photo-item:nth-child(1) { grid-column: 1 / 3; grid-row: 1 / 2; }
  .photo-item:nth-child(4) { grid-column: 3 / 5; grid-row: 2 / 3; }

  .photo-inner {
    width: 100%;
    height: 100%;
    transition: transform 0.6s ease;
    position: relative;
  }

  .photo-item:hover .photo-inner { transform: scale(1.05); }

  .photo-bg {
    width: 100%;
    height: 100%;
    background: var(--royal);
    position: relative;
    overflow: hidden;
  }

  .photo-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.4;
  }

  /* Different gradient for each photo */
  .photo-item:nth-child(1) .photo-bg { background: linear-gradient(135deg, #0D3B6E 0%, #1A5276 100%); }
  .photo-item:nth-child(2) .photo-bg { background: linear-gradient(135deg, #1B2A4A 0%, #2C3E6B 100%); }
  .photo-item:nth-child(3) .photo-bg { background: linear-gradient(135deg, #0A2040 0%, #1A3A6B 100%); }
  .photo-item:nth-child(4) .photo-bg { background: linear-gradient(135deg, #142342 0%, #243865 100%); }
  .photo-item:nth-child(5) .photo-bg { background: linear-gradient(135deg, #0C1A30 0%, #182940 100%); }

  .photo-label {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 20px 20px 16px;
    background: linear-gradient(to top, rgba(10,22,40,0.92) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 2;
  }

  .photo-item:hover .photo-label { opacity: 1; }

  .photo-label span {
    font-size: 12px;
    color: var(--light-gold);
    letter-spacing: 0.1em;
  }

  .photo-icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.12;
  }

  /* ── SPEECH SECTION ── */
  .speech-section {
    padding: 120px 7%;
    background: var(--deep-blue);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .speech-section::before {
    content: '❝';
    position: absolute;
    top: 40px; left: 50%;
    transform: translateX(-50%);
    font-size: 200px;
    color: rgba(200,169,110,0.04);
    font-family: serif;
    line-height: 1;
    pointer-events: none;
  }

  .speech-content {
    max-width: 780px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .speech-quote {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(20px, 2.5vw, 30px);
    font-weight: 600;
    line-height: 1.8;
    color: var(--light-gold);
    margin-bottom: 40px;
    font-style: italic;
  }

  .speech-attr {
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .speech-attr::before,
  .speech-attr::after {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background: rgba(200,169,110,0.3);
  }

  /* ── TIMELINE SECTION ── */
  .timeline-section {
    padding: 120px 7%;
    background: var(--navy);
  }

  .timeline-header {
    margin-bottom: 64px;
  }

  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 120px;
    top: 0; bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--accent), transparent);
  }

  .tl-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    margin-bottom: 48px;
    position: relative;
  }

  .tl-item::after {
    content: '';
    position: absolute;
    left: calc(120px - 4px);
    top: 8px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--navy);
  }

  .tl-year {
    text-align: right;
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--accent);
    padding-top: 4px;
  }

  .tl-content h4 {
    font-family: 'Noto Serif KR', serif;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .tl-content p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    font-weight: 300;
  }

  /* ── CONTACT/PETITION ── */
  .petition-section {
    padding: 120px 7%;
    background: var(--surface);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .petition-content {}

  .petition-form {
    background: var(--card);
    padding: 48px;
    border: 1px solid rgba(200,169,110,0.1);
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(200,169,110,0.15);
    color: var(--white);
    padding: 12px 16px;
    font-size: 14px;
    font-family: 'Noto Sans KR', sans-serif;
    outline: none;
    transition: border-color 0.3s;
    resize: none;
    appearance: none;
  }

  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: var(--accent);
    background: rgba(200,169,110,0.04);
  }

  .form-group textarea { height: 120px; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* ── FOOTER ── */
  footer {
    background: #060E1A;
    padding: 80px 7% 40px;
    border-top: 1px solid rgba(200,169,110,0.1);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 64px;
  }

  .footer-brand {}

  .footer-brand .logo-text .ko {
    font-size: 18px;
    font-family: 'Noto Serif KR', serif;
    margin-bottom: 4px;
    display: block;
    color: var(--white);
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .footer-brand .logo-text .en {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.2em;
    display: block;
    margin-bottom: 20px;
  }

  .footer-brand p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    font-weight: 300;
    max-width: 280px;
  }

  .footer-col h4 {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .footer-col ul { list-style: none; }

  .footer-col ul li {
    margin-bottom: 10px;
  }

  .footer-col ul li a {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
    font-weight: 300;
  }

  .footer-col ul li a:hover { color: var(--text-light); }

  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    font-size: 12px;
    color: var(--muted);
    font-weight: 300;
  }

  .footer-flags {
    display: flex;
    gap: 12px;
  }

  .flag-item {
    width: 28px; height: 20px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
  }

  /* Taegeukgi flag mini */
  .flag-kr {
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── SNS LINKS ── */
  .social-links {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .social-btn {
    width: 36px; height: 36px;
    border: 1px solid rgba(200,169,110,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    color: var(--muted);
  }

  .social-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(200,169,110,0.08);
  }

  /* ── MOBILE NAV ── */
  .mobile-menu { display: none; }

  @media (max-width: 900px) {
    header { padding: 0 20px; }
    nav, .header-cta { display: none; }
    .mobile-menu { display: block; cursor: pointer; background: none; border: none; color: var(--white); }
    .hero-content { padding: 0 20px; }
    .bio-section, .petition-section { grid-template-columns: 1fr; padding: 60px 20px; }
    .agenda-grid { grid-template-columns: 1fr; }
    .news-grid { grid-template-columns: 1fr; }
    .photo-masonry { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .photo-item:nth-child(1), .photo-item:nth-child(4) { grid-column: auto; grid-row: auto; }
    .footer-top { grid-template-columns: 1fr; gap: 32px; }
    .agenda-header, .news-header, .photo-header { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .timeline::before { left: 80px; }
    .tl-item { grid-template-columns: 80px 1fr; gap: 24px; }
    .tl-item::after { left: calc(80px - 4px); }
  }

  /* ── SCROLL REVEAL ── */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  /* Active nav highlight */
  header.scrolled {
    background: rgba(6,14,26,0.95);
    box-shadow: 0 4px 40px rgba(0,0,0,0.4);
  }
</style>
</head>
<body>

