const heroData = [
  {title:'어벤져스: 둠스데이', genre:'액션 · SF', meta:'2026 · 180분 · 루소 형제', desc:'마블 유니버스의 새로운 전환점. 닥터 둠의 등장과 함께 시작되는 장엄한 사투.', idx:0},
  {title:'더 배트맨 파트 2', genre:'액션 · 범죄', meta:'2026 · 175분 · 맷 리브스', desc:'고담시의 어둠 속에 도사린 새로운 위협. 더욱 깊어진 브루스 웨인의 고뇌.', idx:1},
  {title:'프로젝트 하일메리', genre:'SF · 드라마', meta:'2026 · 150분 · 필 로드', desc:'인류를 구하기 위한 마지막 희망. 태양계 밖에서 펼쳐지는 경이로운 우주 생존기.', idx:4},
  {title:'스파이더맨: 비욘드 더 스파이더-버스', genre:'애니메이션 · SF', meta:'2026 · 140분 · 호아킴 도스 산토스', desc:'마일즈 모랄레스의 대장정이 막을 내린다. 스파이더-버스의 운명을 건 마지막 결전.', idx:2},
];

// ── POSTER ICONS ──
function posterSVG(m){
  const s = m.stroke;
  const icons = {
    'sci-fi': `<circle cx="60" cy="55" r="32" stroke="${s}" stroke-width="1.5" fill="none"/><circle cx="60" cy="55" r="12" fill="rgba(${hexToRgb(s)},0.15)"/><line x1="60" y1="23" x2="60" y2="10" stroke="${s}" stroke-width="1.5"/><line x1="60" y1="87" x2="60" y2="100" stroke="${s}" stroke-width="1.5"/><line x1="28" y1="55" x2="15" y2="55" stroke="${s}" stroke-width="1.5"/><line x1="92" y1="55" x2="105" y2="55" stroke="${s}" stroke-width="1.5"/>`,
    'action': `<polygon points="60,20 80,50 100,80 60,68 20,80 40,50" stroke="${s}" stroke-width="1.5" fill="rgba(${hexToRgb(s)},0.08)"/><circle cx="60" cy="55" r="10" fill="rgba(${hexToRgb(s)},0.4)"/>`,
    'drama': `<rect x="20" y="30" width="80" height="90" rx="4" stroke="${s}" stroke-width="1.5" fill="none"/><line x1="30" y1="55" x2="90" y2="55" stroke="${s}" stroke-width="1"/><line x1="30" y1="70" x2="75" y2="70" stroke="${s}" stroke-width="1"/><line x1="30" y1="85" x2="60" y2="85" stroke="${s}" stroke-width="1"/>`,
    'thriller': `<path d="M30 120 Q60 30 90 120" stroke="${s}" stroke-width="1.5" fill="rgba(${hexToRgb(s)},0.06)"/><circle cx="60" cy="65" r="18" stroke="${s}" stroke-width="1.5" fill="none"/><line x1="60" y1="47" x2="60" y2="35" stroke="${s}" stroke-width="1.5"/>`,
    'romance': `<path d="M60 90 L20 50 Q10 30 30 20 Q50 10 60 35 Q70 10 90 20 Q110 30 100 50 Z" stroke="${s}" stroke-width="1.5" fill="rgba(${hexToRgb(s)},0.1)"/>`,
    'comedy': `<circle cx="60" cy="55" r="35" stroke="${s}" stroke-width="1.5" fill="none"/><circle cx="48" cy="48" r="4" fill="${s}"/><circle cx="72" cy="48" r="4" fill="${s}"/><path d="M44 67 Q60 80 76 67" stroke="${s}" stroke-width="2" fill="none" stroke-linecap="round"/>`,
    'horror': `<path d="M60 10 L70 40 L100 40 L78 58 L88 90 L60 70 L32 90 L42 58 L20 40 L50 40 Z" stroke="${s}" stroke-width="1.5" fill="rgba(${hexToRgb(s)},0.08)"/>`,
    'animation': `<rect x="15" y="25" width="90" height="75" rx="8" stroke="${s}" stroke-width="1.5" fill="none"/><circle cx="35" cy="50" r="8" fill="rgba(${hexToRgb(s)},0.3)"/><circle cx="60" cy="50" r="8" fill="rgba(${hexToRgb(s)},0.5)"/><circle cx="85" cy="50" r="8" fill="rgba(${hexToRgb(s)},0.3)"/><line x1="15" y1="70" x2="105" y2="70" stroke="${s}" stroke-width="1" opacity="0.5"/>`,
  };
  return icons[m.genre] || icons['drama'];
}

function hexToRgb(hex){
  const r={
    '#2EC4B6':'46,196,182',
    '#E63946':'230,57,70',
    '#F4A261':'244,162,97',
    '#C9C3B8':'201,195,184',
  };
  return r[hex]||'200,200,200';
}

// ── RENDER ──
let currentFilter = 'all';
let currentSort = 'rating';

function buildCard(m, small=false){
  const badgeHtml = m.badge
    ? `<div class="poster-badge ${m.badge==='NEW'?'new':m.badge==='HOT'?'hot':''}">${m.badge}</div>` : '';
  return `
  <div class="movie-card" onclick="openModal(${m.id})">
    <div class="movie-poster">
      ${badgeHtml}
      <div class="poster-score">${m.rating}</div>
      <div class="poster-art">
        ${m.poster ? `<img src="${m.poster}" alt="${m.title}" style="width:100%;height:100%;object-fit:cover;">` : `
          <div class="poster-bg ${m.genre}">
            <svg class="poster-icon" width="120" height="150" viewBox="0 0 120 150" fill="none">${posterSVG(m)}</svg>
          </div>
        `}
      </div>
      <div class="poster-overlay">
        <div class="overlay-actions">
          <button class="overlay-btn">
            <svg width="10" height="12" viewBox="0 0 10 12" fill="none"><polygon points="0,0 10,6 0,12" fill="#fff"/></svg>
            상세 보기
          </button>
          <button class="overlay-btn outline">♡ 찜하기</button>
        </div>
      </div>
    </div>
    <div class="movie-info">
      <div class="movie-title">${m.title}</div>
      <div class="movie-sub">
        <span class="genre-tag">${m.genreLabel.split('·')[0].trim()}</span>
        <span class="sep">·</span>
        <span>${m.year}</span>
        <span class="sep">·</span>
        <span>★ ${m.rating}</span>
      </div>
    </div>
  </div>`;
}

function renderGrid(){
  const grid = document.getElementById('movieGrid');
  if(!grid) return;
  let list = [...movies];
  const q = document.getElementById('searchInput').value.toLowerCase();
  if(q) list = list.filter(m=>m.title.toLowerCase().includes(q)||m.director.toLowerCase().includes(q));
  if(currentFilter!=='all') list = list.filter(m=>m.genre===currentFilter);
  if(currentSort==='rating') list.sort((a,b)=>b.rating-a.rating);
  else if(currentSort==='year') list.sort((a,b)=>b.year-a.year);
  else list.sort((a,b)=>a.title.localeCompare(b.title));
  grid.innerHTML = list.length ? list.map(m=>buildCard(m)).join('') : `<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--muted)">검색 결과가 없습니다.</div>`;
}

function renderChart(){
  const sorted = [...movies].sort((a,b)=>b.rating-a.rating).slice(0,8);
  document.getElementById('chartList').innerHTML = sorted.map((m,i)=>`
    <div class="chart-item" onclick="openModal(${m.id})">
      <div class="chart-rank ${i<3?'top3':''}">${String(i+1).padStart(2,'0')}</div>
      <div class="chart-thumb">
        <div class="chart-thumb-inner">
          ${m.poster ? `<img src="${m.poster}" alt="${m.title}" style="width:100%;height:100%;object-fit:cover;">` : `
            <div class="poster-bg ${m.genre}" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center">
              <svg width="40" height="50" viewBox="0 0 120 150" fill="none" opacity="0.5">${posterSVG(m)}</svg>
            </div>
          `}
        </div>
      </div>
      <div class="chart-info">
        <div class="ci-title">${m.title}</div>
        <div class="ci-sub">${m.director} · ${m.year}</div>
        <div class="chart-ott-wrap">
          ${m.ott.map(o => `<span class="ott-badge">${o}</span>`).join('')}
        </div>
        <div class="chart-review">${m.ottReview}</div>
      </div>
      <div class="chart-score">${m.rating}<small>/ 10</small></div>
    </div>`).join('');
}

function renderNewRelease(){
  const recent = [...movies].filter(m=>m.badge==='UPCOMING').sort((a,b)=>b.year-a.year).slice(0,8);
  document.getElementById('newReleaseRow').innerHTML = recent.map(m=>buildCard(m,true)).join('');
}

function renderNowPlaying(){
  const playing = [...movies].filter(m=>m.badge==='NOW').sort((a,b)=>b.rating-a.rating);
  document.getElementById('nowPlayingRow').innerHTML = playing.map(m=>buildCard(m,true)).join('');
}

function filterMovies(){renderGrid();}
function setFilter(btn,f){
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  currentFilter=f;
  renderGrid();
}
function setFilterDirect(f){
  currentFilter=f;
  document.querySelectorAll('.filter-btn').forEach(b=>{
    b.classList.toggle('active', b.textContent.toLowerCase()===genreMap[f]);
  });
  renderGrid();
  document.getElementById('chart').scrollIntoView({behavior:'smooth'});
}
const genreMap={'action':'액션','sci-fi':'sf','drama':'드라마','thriller':'스릴러','romance':'로맨스','comedy':'코미디','horror':'공포','animation':'애니메이션'};
function sortMovies(v){currentSort=v;renderGrid();}

// ── MODAL ──
function openModal(id){
  const m = movies[id];
  if(!m)return;
  const bgColors = {'sci-fi':'linear-gradient(160deg,#050A1A 0%,#0D1A3D 100%)','action':'linear-gradient(160deg,#1A0A0A 0%,#2D1515 100%)','drama':'linear-gradient(160deg,#0A0A15 0%,#15152D 100%)','thriller':'linear-gradient(160deg,#050505 0%,#151515 100%)','romance':'linear-gradient(160deg,#1A0A0F 0%,#2D1520 100%)','comedy':'linear-gradient(160deg,#0A1200 0%,#152000 100%)','horror':'linear-gradient(160deg,#060200 0%,#100800 100%)','animation':'linear-gradient(160deg,#001A1A 0%,#002D2D 100%)'};
  const pBox = document.getElementById('modalPosterBg');
  if(m.poster){
    pBox.style.background = `url(${m.poster}) center/cover no-repeat`;
    pBox.innerHTML = '';
  } else {
    pBox.style.background = bgColors[m.genre]||bgColors.drama;
    pBox.innerHTML = `<svg width="100" height="140" viewBox="0 0 120 150" fill="none" opacity="0.35">${posterSVG(m)}</svg>`;
  }
  document.getElementById('modalGenre').textContent = m.genreLabel;
  document.getElementById('modalTitle').textContent = m.title;
  document.getElementById('modalScore').textContent = `★ ${m.rating}`;
  document.getElementById('modalYear').textContent = m.year;
  document.getElementById('modalRuntime').textContent = m.runtime;
  document.getElementById('modalDirector').textContent = m.director;
  document.getElementById('modalDesc').textContent = m.desc;
  document.getElementById('modalCast').innerHTML = m.cast.map(c=>`<span class="cast-pill">${c}</span>`).join('');
  document.getElementById('modalOverlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeModal(){
  document.getElementById('modalOverlay').classList.remove('open');
  document.body.style.overflow='';
}
function closeModalOutside(e){if(e.target===document.getElementById('modalOverlay'))closeModal();}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});

// ── HERO SLIDER ──
let currentSlide = 0;
let slideTimer;

function goSlide(n){
  const slides = document.querySelectorAll('.hero-slide');
  const btns = document.querySelectorAll('#heroIndicators button');
  slides[currentSlide].classList.remove('active');
  btns[currentSlide].classList.remove('active');
  currentSlide = n;
  slides[currentSlide].classList.add('active');
  btns[currentSlide].classList.add('active');
  const h = heroData[currentSlide];
  const content = document.getElementById('heroContent');
  content.style.opacity='0';
  content.style.transform='translateY(16px)';
  setTimeout(()=>{
    document.getElementById('heroGenre').textContent=h.genre;
    document.getElementById('heroTitle').textContent=h.title;
    document.getElementById('heroMeta').textContent=h.meta;
    document.getElementById('heroDesc').textContent=h.desc;
    // Update watch button
    document.querySelector('.btn-watch').onclick=()=>openModal(h.idx);
    content.style.transition='opacity 0.6s ease, transform 0.6s ease';
    content.style.opacity='1';
    content.style.transform='translateY(0)';
  },200);
  resetTimer();
}

function nextSlide(){goSlide((currentSlide+1)%heroData.length);}
function resetTimer(){clearInterval(slideTimer);slideTimer=setInterval(nextSlide,5500);}
slideTimer=setInterval(nextSlide,5500);

// ── CURSOR ──
const cur=document.getElementById('cur');
const curRing=document.getElementById('curRing');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px';});
(function animRing(){rx+=(mx-rx)*0.14;ry+=(my-ry)*0.14;curRing.style.left=rx+'px';curRing.style.top=ry+'px';requestAnimationFrame(animRing);})();
document.querySelectorAll('a,button,.movie-card,.editorial-main,.editorial-item,.chart-item,.genre-tile').forEach(el=>{
  el.addEventListener('mouseenter',()=>document.body.classList.add('hovering'));
  el.addEventListener('mouseleave',()=>document.body.classList.remove('hovering'));
});

// ── SCROLL REVEAL ──
const revObs = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){e.target.classList.add('visible');revObs.unobserve(e.target);}
  });
},{threshold:0.1,rootMargin:'0px 0px -32px 0px'});
document.querySelectorAll('.reveal').forEach(el=>revObs.observe(el));

// ── INIT ──
renderGrid();
renderChart();
renderNewRelease();
renderNowPlaying();

// Lazy re-observe after render
setTimeout(()=>{
  document.querySelectorAll('.reveal:not(.visible)').forEach(el=>revObs.observe(el));
},100);
</script>
