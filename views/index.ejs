  },
  {
    id:13, title:'하얼빈 2', genre:'action', genreLabel:'액션 · 시대극', year:2026, runtime:'130분', director:'우민호', rating:9.5, badge:'NOW', 
    desc:'안중근 의사의 거사 그 이후, 남겨진 독립투사들의 치열한 사투를 그린 대작. 1편의 감동을 잇는 장엄한 서사와 배우들의 명연기가 돋보인다. 현재 네이버 박스오피스 상위권을 지키고 있는 올 상반기 최고의 기대작.', 
    cast:['현빈', '박정민', '조우진'], color:'rgba(201,195,184,0.06)', stroke:'#C9C3B8', 
